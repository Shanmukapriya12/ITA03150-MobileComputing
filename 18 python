
import matplotlib.pyplot as plt

# Function to calculate Erlang B blocking probability
def erlang_b(E, m):
    B = 1.0
    for k in range(1, m + 1):
        B = (E * B) / (k + E * B)
    return B

# Given traffic loads and channels
loads = [2, 5, 10, 20]
channels = [5, 10, 15, 20, 25, 30]

# Print blocking probability table
print("Blocking probability (%)")
print("E \\ m", end="")

for m in channels:
    print(f"{m:>10}", end="")
print()

for E in loads:
    print(f"{E:>5}", end="")
    for m in channels:
        print(f"{100 * erlang_b(E, m):10.3f}", end="")
    print()

# Calculate required channels for E = 10 and GoS = 2%
E = 10
target = 0.02
m = 1

while erlang_b(E, m) > target:
    m += 1

print(f"\nFor E = {E} Erlangs and GoS = {target*100:.0f}%")
print(f"Channels required = {m}")

# Plot blocking probability curves
plt.figure(figsize=(9, 5))

for E in loads:
    probabilities = [100 * erlang_b(E, m) for m in range(1, 31)]
    plt.plot(range(1, 31), probabilities, marker='o',
             markersize=3, label=f'E = {E} Erlangs')

# Mark target GoS for E = 10
plt.axhline(y=2, color='red', linestyle='--',
            label='GoS = 2%')

plt.xlabel("Number of Channels (m)")
plt.ylabel("Blocking Probability (%)")
plt.title("Call Blocking Probability Using Erlang B Formula")
plt.grid(True)
plt.legend()
plt.tight_layout()
plt.show()
