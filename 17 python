
import math
import matplotlib.pyplot as plt

S = 420 # total duplex channels available
M = 10 # number of times the cluster is replicated
n = 4 # path-loss exponent (urban)

valid = sorted({i*i + i*j + j*j for i in range(0, 5) for j in range(0, 5)} - {0})[:8]

print(f"{'N':>3}{'D/R':>8}{'ch/cell':>9}{'Capacity C':>12}{'S/I (dB)':>10}")

capacity_values = []
si_values = []

for N in valid:
    Q = math.sqrt(3*N) # co-channel reuse ratio D/R
    k = S // N # channels per cell
    C = M * k * N # system capacity = M*k*N
    si = (Q**n) / 6 # 6 first-tier interferers

    si_db = 10*math.log10(si)

    print(f"{N:>3}{Q:8.3f}{k:9d}{C:12d}{si_db:10.2f}")

    capacity_values.append(C)
    si_values.append(si_db)

req = 18.0 # AMPS requirement (dB)

for N in valid:
    if 10*math.log10((math.sqrt(3*N)**n)/6) >= req:
        print(f"\nSmallest cluster size meeting S/I >= {req} dB : N = {N}")
        break

# Graph 1: Cluster Size vs S/I

plt.figure(figsize=(8, 5))
plt.plot(valid, si_values, marker='o')
plt.xlabel("Cluster Size (N)")
plt.ylabel("S/I (dB)")
plt.title("Cluster Size vs Signal-to-Interference Ratio")
plt.grid(True)
plt.show()

# Graph 2: Cluster Size vs System Capacity

plt.figure(figsize=(8, 5))
plt.plot(valid, capacity_values, marker='o')
plt.xlabel("Cluster Size (N)")
plt.ylabel("System Capacity")
plt.title("Cluster Size vs System Capacity")
plt.grid(True)
plt.show()
