
import numpy as np
import matplotlib.pyplot as plt

# Step 1: Initialize parameters
rng = np.random.default_rng(1)

U = 6
TTI = 2000
RB = 1

mean_snr_db = np.array([25, 20, 15, 10, 5, 0])
mean_snr = 10 ** (mean_snr_db / 10)

# Step 2: Generate Rayleigh fading and calculate rate
rate = np.log2(1 + mean_snr * rng.exponential(1.0, (TTI, U)))

# Step 3: Jain's fairness index
def jain(x):
    return x.sum() ** 2 / (len(x) * (x ** 2).sum())

# Step 4: Simulate scheduling algorithms
def simulate(policy):
    served = np.zeros(U)
    avg = np.ones(U)

    for t in range(TTI):

        if policy == 'RR':
            u = t % U

        elif policy == 'MaxCI':
            u = np.argmax(rate[t])

        else:
            u = np.argmax(rate[t] / avg)

        served[u] += rate[t, u]

        inst = np.zeros(U)
        inst[u] = rate[t, u]

        avg = 0.99 * avg + 0.01 * inst

    return served / TTI

# Step 5: Calculate results
policies = ['RR', 'MaxCI', 'PF']

results = {}
totals = []
fairness = []

print(f"{'Scheduler':>10} | " +
      " ".join(f"U{i+1:>5}" for i in range(U)) +
      " | Total | Jain")

for p in policies:
    th = simulate(p)

    results[p] = th
    totals.append(th.sum())
    fairness.append(jain(th))

    print(f"{p:>10} | " +
          " ".join(f"{v:6.3f}" for v in th) +
          f" | {th.sum():6.3f} | {jain(th):.3f}")

# Step 6: Plot 3 graphs together
fig, axes = plt.subplots(1, 3, figsize=(16, 5))

# Graph 1: Per-user throughput comparison
users = np.arange(U)
width = 0.25

for i, p in enumerate(policies):
    axes[0].bar(users + i * width, results[p],
                width, label=p)

axes[0].set_title("Per-User Throughput")
axes[0].set_xlabel("Users")
axes[0].set_ylabel("Throughput (b/s/Hz)")
axes[0].set_xticks(users + width)
axes[0].set_xticklabels([f'U{i+1}' for i in users])
axes[0].legend()
axes[0].grid(axis='y', alpha=0.4)

# Graph 2: Total throughput comparison
axes[1].bar(policies, totals, color='orange')
axes[1].set_title("Total Throughput Comparison")
axes[1].set_xlabel("Scheduling Algorithms")
axes[1].set_ylabel("Total Throughput (b/s/Hz)")

for i, v in enumerate(totals):
    axes[1].text(i, v + 0.1, f'{v:.3f}', ha='center')

axes[1].grid(axis='y', alpha=0.4)

# Graph 3: Jain's fairness index
axes[2].bar(policies, fairness, color='green')
axes[2].set_title("Jain's Fairness Index")
axes[2].set_xlabel("Scheduling Algorithms")
axes[2].set_ylabel("Fairness Index")
axes[2].set_ylim(0, 1)

for i, v in enumerate(fairness):
    axes[2].text(i, v + 0.02, f'{v:.3f}', ha='center')

axes[2].grid(axis='y', alpha=0.4)

plt.tight_layout()
plt.show()
